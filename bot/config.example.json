{
  "$comment": "AutoPoster 配置：复制为 config.json 并改成 Mac 绝对路径；勿提交含真实手机号的 config.json",
  "dryRun": true,
  "concurrency": 1,
  "rateLimitMs": 120000,
  "maxPostsPerDay": 10,
  "matrixMedia": {
    "bin": "/Applications/matrixmedia.app/Contents/MacOS/matrixmedia",
    "repoRoot": null,
    "preferHttp": false,
    "httpBaseUrl": "http://127.0.0.1:30088"
  },
  "defaults": {
    "title": "{{filename}}",
    "description": "本视频由 AI 辅助创作，欢迎交流。",
    "tags": "AI 创作 日常",
    "platforms": ["tt", "xhs"],
    "name": "{{filename}}"
  },
  "accounts": {
    "tt": {
      "phone": "你的头条账号分组或手机号"
    },
    "xhs": {
      "phone": "你的小红书账号分组或手机号"
    },
    "dy": {
      "phone": "可选：抖音账号"
    },
    "ks": {
      "phone": "可选：快手账号"
    }
  },
  "queue": {
    "incomingDir": "/Users/steven/MatrixMedia/bot/queue/incoming",
    "processingDir": "/Users/steven/MatrixMedia/bot/queue/processing",
    "doneDir": "/Users/steven/MatrixMedia/bot/queue/done",
    "failedDir": "/Users/steven/MatrixMedia/bot/queue/failed"
  },
  "stateFile": "/Users/steven/MatrixMedia/bot/queue/.bot-state.json",
  "schedule": {
    "pollIntervalMs": 30000
  }
}
